  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.respectGitIgnore": true,
  "yaml.schemas": {
    "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/main/schemas/v3.0/schema.json": [
      "tap26/openapi/openapi.yaml"
